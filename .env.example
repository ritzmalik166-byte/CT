# Copy this file to `.env.local` and fill in your Aiven MySQL credentials.

# Option 1: Full connection string (recommended for Aiven)
# Get this from Aiven Console -> Your MySQL service -> Connection information -> Connection URI
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Option 2: Individual variables (alternative)
# DB_HOST="YOUR_HOST.a.aivencloud.com"
# DB_PORT="12345"
# DB_USER="avnadmin"
# DB_PASSWORD="YOUR_PASSWORD"
# DB_NAME="defaultdb"
# DB_SSL="true"
# DB_SSL_CA_PATH="./database/ca.pem"
# DB_SSL_REJECT_UNAUTHORIZED="true"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: first admin seed (used by npm run db:seed-admin)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@contenaissance.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Azure Blob Storage (blog image uploads)
# Option 1: full connection string (recommended)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
# Option 2: account name + key (alternative to connection string)
# AZURE_STORAGE_ACCOUNT_NAME="contenaissance"
# AZURE_STORAGE_ACCOUNT_KEY="your-account-key"
# Container and folder for blog images (defaults shown)
AZURE_STORAGE_CONTAINER="ct-assets"
AZURE_STORAGE_BLOG_PREFIX="blog"
