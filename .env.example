# Copy this file to `.env.local` and fill in your Aiven MySQL credentials.

# Option 1: Full connection string (recommended for Aiven)
# Get this from Aiven Console -> Your MySQL service -> Connection information -> Connection URI
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Option 2: Individual variables (alternative)
# DB_HOST="YOUR_HOST.a.aivencloud.com"
# DB_PORT="12345"
# DB_USER="avnadmin"
# DB_PASSWORD="YOUR_PASSWORD"
# DB_NAME="defaultdb"
# DB_SSL="true"
# DB_SSL_CA_PATH="./database/ca.pem"
# DB_SSL_REJECT_UNAUTHORIZED="true"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: first admin seed (used by npm run db:seed-admin)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@contenaissance.com"
ADMIN_PASSWORD="your-pass"

# Azure Blob Storage (blog image uploads)
# Option 1: full connection string (recommended)
AZURE_STORAGE_CONNECTION_STRING="replace-with-actual"
# Option 2: account name + key (alternative to connection string)
# AZURE_STORAGE_ACCOUNT_NAME="contenaissance"
# AZURE_STORAGE_ACCOUNT_KEY="your-account-key"
# Container and folder for blog images (defaults shown)
AZURE_STORAGE_CONTAINER="ct-assets"
AZURE_STORAGE_BLOG_PREFIX="blog"

# Email OTP (international numbers) + micro-enquiry admin alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email
SMTP_PASS=your-pass
MAIL_FROM="Contenaissance <your-email>"
ENQUIRY_ADMIN_EMAIL=your-email
OTP_HASH_SECRET=your-pass




TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-bot-id
# Claude MCP blog connector (/api/mcp)
# Shared bearer secret, min 32 chars (e.g. `openssl rand -hex 32`). Use the same value in the Claude connector.
CT_MCP_SECRET=
# users.id of the panel account Claude acts as (must be active and have can_manage_blogs, or be superadmin)
CT_AGENT_USER_ID=1
# Google service account used to read Google Docs (can be the same one as RMW).
# Drive API must be enabled in its Google Cloud project; share each doc with this email as Viewer.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""